.DS_Store

# scripts/build_source_archive.py's default output directory.
dist/

# Never commit credentials. The colony can spend real money, so a leaked
# ANTHROPIC_API_KEY is a billable incident, not just an exposure.
.env
.env.*

# SQLite write-ahead log and shared-memory files beside any colony database —
# they carry recent writes, and the repo is public.
*.db-wal
*.db-shm
